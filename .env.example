# RayPlus API Key，用于调用 RayPlus/Codex 相关接口；请替换为自己的 sk- 开头密钥。
RAYPLUS_API_KEY=sk-your-api-key
# RayPlus 登录邮箱，用于服务自动登录并查询/重置订阅额度。
RAYPLUS_EMAIL=you@example.com
# RayPlus 登录密码；建议只放在本地 .env，不要提交真实密码。
RAYPLUS_PASSWORD=your-password

# SMTP 登录用户名，通常是发件邮箱或邮箱服务商提供的账号。
SMTP_USER=you@example.com
# SMTP 登录密码或邮箱授权码；不同邮箱服务商可能需要使用专门的应用授权码。
SMTP_PASSWORD=your-smtp-password

# PostgreSQL 主机地址；本机数据库通常使用 127.0.0.1。
pg_host=127.0.0.1
# PostgreSQL 端口；默认端口是 5432。
pg_port=5432
# PostgreSQL 用户名。
pg_user=postgres
# PostgreSQL 密码；如果数据库用户无密码，可留空但不推荐。
pg_password=postgres-password
# PostgreSQL 数据库名，服务会在该库中创建 reset_logs、confirm_tokens 等表。
pg_database=auto_reset_remaining

# 日志轮转接口的访问密钥；仅在 config.toml 中启用 logs.rotation.enabled 时必填。
LOG_ROTATION_KEY=change-this-log-rotation-key
# 手动重发重置确认邮件接口 /resend-reset-email 的访问密钥，必填。
RESEND_RESET_EMAIL_KEY=change-this-resend-reset-email-key
# 是否允许外部调用 /manual-reset-subscription 手动重置订阅；true/false。
EXTERNAL_MANUAL_RESET_ENABLED=false
# 外部手动重置接口的访问密钥；仅当 EXTERNAL_MANUAL_RESET_ENABLED=true 时必填。
EXTERNAL_MANUAL_RESET_KEY=change-this-external-manual-reset-key
# 测试重置邮件接口 /test-reset-email 的访问密钥，必填。
TEST_RESET_EMAIL_KEY=change-this-test-reset-email-key
# 撤销未确认重置邮件接口 /cancel-reset-emails 的访问密钥，必填。
CANCEL_RESET_EMAIL_KEY=change-this-cancel-reset-email-key
