RAYPLUS_BASE_URL=https://rayplus.site
RAYPLUS_API_KEY=sk-your-api-key
RAYPLUS_EMAIL=you@example.com
RAYPLUS_PASSWORD=your-password

CODEX_BASE_URL=https://codex.rayplus.site
SUBSCRIPTION_ID=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=you@example.com
SMTP_TO=receiver@example.com

pg_host=127.0.0.1
pg_port=5432
pg_user=postgres
pg_password=postgres-password
pg_database=auto_reset_remaining
pg_sslmode=disable

PUBLIC_BASE_URL=https://your-public-service.example.com
HTTP_ADDR=127.0.0.1:8080
QUERY_LOG_DIR=logs
LOG_ROTATION_ENABLED=false
LOG_ROTATION_ARCHIVE_DIR=log_archives
LOG_ROTATION_KEY=change-this-log-rotation-key
LOW_BALANCE_THRESHOLD=0.5
BALANCE_JSON_PATH=
AUTO_RESET_ENABLED=false
MANUAL_CONFIRM_SUCCESS_COUNT=0
POLL_INTERVAL=1s
CONFIRM_TOKEN_TTL=24h
RESET_COOLDOWN=1m
USER_AGENT=auto-reset-remaining/1.0
